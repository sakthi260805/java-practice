public class LargestOfTwo {

    
    static int largest(int a, int b) {
        if (a > b)
            return a;
        else
            return b;
    }

    public static void main(String[] args) {
        int num1 = 10;
        int num2 = 25;

        System.out.println("Largest number is: " + largest(num1, num2));
    }
}
